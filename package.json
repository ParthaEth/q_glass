{
  "name": "q_glass",
  "version": "0.1.0",
  "private": true,
  "description": "Glass-box control panel for declared Temporal stage graphs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:open": "vite --host 127.0.0.1 --port 5173 --open",
    "build": "tsc --noEmit && vite build",
    "build:telemetry-embed": "tsc --noEmit && vite build --base /q-glass/ --outDir ../../../frontend/public/q-glass --emptyOutDir",
    "preview": "vite preview --host 127.0.0.1 --port 5173"
  },
  "dependencies": {
    "@xyflow/react": "^12.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
